# Database (Neon PostgreSQL)
# DATABASE_URL = Pooled connection string (pgbouncer) untuk runtime aplikasi
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED = Direct connection string (port 5432) untuk migrasi Prisma
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"

# OSRM & Routing (Email kontak di User-Agent)
OSRM_CONTACT_EMAIL="your_email@example.com"
# ORS_API_KEY opsional sebagai fallback jika OSRM gagal
ORS_API_KEY=""

# Map Tiles & App URL
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
