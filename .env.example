# Database (Neon PostgreSQL)
# DATABASE_URL = Pooled connection string (pgbouncer) untuk runtime aplikasi
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.example-neon-host/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED = Direct connection string (port 5432) untuk migrasi Prisma
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.example-neon-host/neondb?sslmode=require"

# Pengaman Host Skrip (Wajib diisi sesuai hostname DATABASE_URL sebelum seed/audit)
SEED_TARGET_HOST="HOST-pooler.REGION.aws.example-neon-host"
AUDIT_TARGET_HOST="HOST-pooler.REGION.aws.example-neon-host"

# Midtrans Payment Gateway (QRIS Sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SANDBOX_SERVER_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY"

# OSRM & Routing (Email kontak di User-Agent)
OSRM_CONTACT_EMAIL="your-email@example.com"
# ORS_API_KEY opsional sebagai fallback jika OSRM gagal
ORS_API_KEY=""

# Map Tiles & App URL
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
